# Copy to .env.local and fill in real values. Never commit .env.local.
# Server-only: no VITE_ prefix, so these never reach the browser bundle.

# Go backend base URL (called from loaders only)
API_BASE_URL=http://localhost:8080

# Raw read key; the backend stores its SHA-256 as API_READ_KEY_SHA256
API_READ_KEY=<read-key>
