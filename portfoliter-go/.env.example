# Copy to .env.local and fill in real values. Never commit .env.local.

# HTTP server
APP_PORT=8080

# PostgreSQL
DB_HOST=<postgres-host>
DB_PORT=5432
DB_USER=<postgres-user>
DB_PASSWORD=<postgres-password>
DB_NAME=<postgres-database>
DB_SSLMODE=require

# SHA-256 (hex) of the frontend's API_READ_KEY.
# Generate: KEY=$(openssl rand -hex 32); printf %s "$KEY" | shasum -a 256
API_READ_KEY_SHA256=<sha256-hex-of-read-key>

# SHA-256 (hex) of the MCP write key; clients send "Authorization: Bearer <key>" to /mcp.
# Must differ from the read key. Generate the same way as above.
API_WRITE_KEY_SHA256=<sha256-hex-of-write-key>

# Cloudflare R2 (private bucket). Token: R2 > Manage API tokens > Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=<bucket-name>
# Optional: lifetime of presigned download / upload URLs (defaults 1h / 15m)
R2_GET_URL_TTL=1h
R2_PUT_URL_TTL=15m

# Public origin of the site, no trailing slash (local: http://localhost:8080).
# Used for OAuth sign-in so Claude web connectors can reach /mcp without a static header.
PUBLIC_BASE_URL=<https://your-domain>
# Optional: hosts whose client_id metadata documents may sign in (default claude.ai,claude.com)
# OAUTH_ALLOWED_CLIENT_HOSTS=claude.ai,claude.com
